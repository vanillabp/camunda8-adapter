<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_taskmatrix" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:error id="ErrPayment" name="PaymentFailed" errorCode="PAYMENT_FAILED" />
  <bpmn:process id="TaskProcess" isExecutable="true">
    <bpmn:startEvent id="TP_start">
      <bpmn:outgoing>TP_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="TP_f1" sourceRef="TP_start" targetRef="TP_happy" />
    <bpmn:serviceTask id="TP_happy">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="happyTask" />
      </bpmn:extensionElements>
      <bpmn:incoming>TP_f1</bpmn:incoming>
      <bpmn:outgoing>TP_f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="TP_f2" sourceRef="TP_happy" targetRef="TP_error" />
    <bpmn:serviceTask id="TP_error">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="errorTask" />
      </bpmn:extensionElements>
      <bpmn:incoming>TP_f2</bpmn:incoming>
      <bpmn:outgoing>TP_f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="TP_boundary" attachedToRef="TP_error">
      <bpmn:outgoing>TP_fErr</bpmn:outgoing>
      <bpmn:errorEventDefinition id="TP_errDef" errorRef="ErrPayment" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="TP_fErr" sourceRef="TP_boundary" targetRef="TP_handle" />
    <bpmn:serviceTask id="TP_handle">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="errorHandled" />
      </bpmn:extensionElements>
      <bpmn:incoming>TP_fErr</bpmn:incoming>
      <bpmn:outgoing>TP_f4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="TP_f3" sourceRef="TP_error" targetRef="TP_end" />
    <bpmn:sequenceFlow id="TP_f4" sourceRef="TP_handle" targetRef="TP_endHandled" />
    <bpmn:endEvent id="TP_end">
      <bpmn:incoming>TP_f3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="TP_endHandled">
      <bpmn:incoming>TP_f4</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="FailProcess" isExecutable="true">
    <bpmn:startEvent id="FP_start">
      <bpmn:outgoing>FP_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="FP_f1" sourceRef="FP_start" targetRef="FP_task" />
    <bpmn:serviceTask id="FP_task">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="alwaysFails" />
      </bpmn:extensionElements>
      <bpmn:incoming>FP_f1</bpmn:incoming>
      <bpmn:outgoing>FP_f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="FP_f2" sourceRef="FP_task" targetRef="FP_end" />
    <bpmn:endEvent id="FP_end">
      <bpmn:incoming>FP_f2</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="RetryProcess" isExecutable="true">
    <bpmn:startEvent id="RP_start">
      <bpmn:outgoing>RP_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="RP_f1" sourceRef="RP_start" targetRef="RP_task" />
    <bpmn:serviceTask id="RP_task">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="retryTask" />
      </bpmn:extensionElements>
      <bpmn:incoming>RP_f1</bpmn:incoming>
      <bpmn:outgoing>RP_f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="RP_f2" sourceRef="RP_task" targetRef="RP_end" />
    <bpmn:endEvent id="RP_end">
      <bpmn:incoming>RP_f2</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="AsyncProcess" isExecutable="true">
    <bpmn:startEvent id="AP_start">
      <bpmn:outgoing>AP_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="AP_f1" sourceRef="AP_start" targetRef="AP_task" />
    <bpmn:serviceTask id="AP_task">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="asyncTask" />
      </bpmn:extensionElements>
      <bpmn:incoming>AP_f1</bpmn:incoming>
      <bpmn:outgoing>AP_f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="AP_f2" sourceRef="AP_task" targetRef="AP_end" />
    <bpmn:endEvent id="AP_end">
      <bpmn:incoming>AP_f2</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
