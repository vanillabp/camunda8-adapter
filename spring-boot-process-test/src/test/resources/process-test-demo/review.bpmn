<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  id="Definitions_Review" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="ReviewProcess" isExecutable="true">
    <bpmn:startEvent id="ReviewStart"><bpmn:outgoing>r1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="r1" sourceRef="ReviewStart" targetRef="ReviewOrder" />
    <bpmn:userTask id="ReviewOrder">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition externalReference="reviewOrder" />
      </bpmn:extensionElements>
      <bpmn:incoming>r1</bpmn:incoming><bpmn:outgoing>r2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="r2" sourceRef="ReviewOrder" targetRef="ReviewEnd" />
    <bpmn:endEvent id="ReviewEnd">
      <bpmn:extensionElements>
        <zeebe:executionListeners>
          <zeebe:executionListener eventType="end" type="archiveTheReview" />
        </zeebe:executionListeners>
      </bpmn:extensionElements>
      <bpmn:incoming>r2</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
