<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.camunda.community.vanillabp</groupId>
  <artifactId>camunda8-adapter-parent</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>
  <name>VanillaBP Camunda 8 adapter</name>
  <description>VanillaBP adapter for Camunda 8 (Version 2)</description>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>VanillaBP</id>
      <organization>Phactum Softwareentwicklung GmbH</organization>
      <organizationUrl>https://www.phactum.at</organizationUrl>
    </developer>
  </developers>

  <modules>
    <module>core</module>
    <module>spring-boot</module>
    <module>election-integration-test</module>
    <module>smoke-test</module>
    <module>quarkus/runtime</module>
    <module>quarkus/deployment</module>
    <module>quarkus/integration-tests</module>
    <module>quarkus/native-image-tests</module>
    <module>test-coverage-report</module>
  </modules>

  <distributionManagement>
    <snapshotRepository>
      <id>github</id>
      <name>Github Packages</name>
      <url>https://maven.pkg.github.com/vanillabp/camunda8-adapter</url>
    </snapshotRepository>
  </distributionManagement>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <version.java>21</version.java>
    <jacoco.version>0.8.15</jacoco.version>
    <!-- where the build breaks, in PERCENT of covered instructions per platform,
         enforced by test-coverage-report/coverage-gate. The rule stays 90 per platform, which is
         the number the coverage badges of the README are read against. The gate stands at
         85, the same number in every VanillaBP repository, because a threshold marks the
         point where somebody has to look and not the goal to aim at. It is never raised to whatever a
         suite happens to reach, and never lowered to make a build pass. Every release line
         is judged by this one number, and line 8.10 is why it is not the rule itself: that
         line excludes the tests of a cluster bug it cannot pass (see the line-8.10 profile),
         which costs it about a point and a quarter on either platform, and a gate set to 90
         turned that into a red matrix every night over coverage nobody was able to write. -->
    <coverage.threshold.spring-boot>85</coverage.threshold.spring-boot>
    <coverage.threshold.quarkus>85</coverage.threshold.quarkus>
    <!-- the rule, as a number the gate can print: it reports every run against both, so
         the distance between a passing build and the rule is readable without opening
         the report -->
    <coverage.rule>90</coverage.rule>
    <lombok.version>1.18.46</lombok.version>
    <spi-for-java.version>1.2.0-SNAPSHOT</spi-for-java.version>
    <adapter-platform.version>2.0.0-SNAPSHOT</adapter-platform.version>
    <springboot.version>4.1.1</springboot.version>
    <quarkus.version>3.37.4</quarkus.version>
    <!-- The Netty version the Quarkus platform manages, which is the one a Quarkus
         application runs the adapter on. It is named here because this repository imports
         the Spring Boot BOM first, so every module otherwise sees Spring Boot's newer
         Netty - see quarkus/native-image-tests, which has to see what an application
         sees. Raise it with the Quarkus version, never past it. -->
    <netty.version.quarkus>4.1.135.Final</netty.version.quarkus>
    <!-- The version of every artifact, resolved into the published POMs by the
         flatten plugin. A plain 'mvn install' builds 2.0.0-SNAPSHOT of the current GA
         line, which is what a developer of this repository wants and needs to remember
         no property for. A release of a line adds the line to it, e.g.
         '-Pline-8.8 -Drevision=2.1.0-8.8'. See the README, section "Release lines". -->
    <revision>2.0.0-SNAPSHOT</revision>
    <!-- The release line this build produces: the Camunda client it is compiled against
         and, because a client is only promised against clusters of its own version and
         newer, the lowest cluster version the artifacts accept. Every line is built from
         THIS source tree, so a fix exists on every line the moment it is committed.
         The properties below are what Renovate maintains, one per line, and what the
         line-* profiles select. Their values are the pins the CI matrix runs. -->
    <camunda8.line>8.9</camunda8.line>
    <camunda8.version>${camunda8.version.line-8.9}</camunda8.version>
    <camunda8.version.line-8.8>8.8.36</camunda8.version.line-8.8>
    <camunda8.version.line-8.9>8.9.16</camunda8.version.line-8.9>
    <camunda8.version.line-8.10>8.10.0-alpha4</camunda8.version.line-8.10>
    <!-- optional: the adapter's own meters are published where the application brings
         Micrometer (see MicrometerCamunda8Metrics). Pinned to the OLDER of both
         platforms, like the platform integration does it (Quarkus 3.37.1 manages 1.16.6,
         Spring Boot 4.1.0 manages 1.17.0) -->
    <micrometer.version>1.16.6</micrometer.version>
    <protobuf.version>4.35.1</protobuf.version>
    <!-- the cluster the integration tests run against follows the pinned client: the
         client a build was compiled against IS the minimum cluster version of that
         build, so testing anything newer would prove nothing about it -->
    <camunda8.cluster.image>camunda/camunda:${camunda8.version}</camunda8.cluster.image>
    <testcontainers.version>2.0.5</testcontainers.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Protobuf refuses a runtime older than the generated code linked against it, and
           the Camunda client brings generated code: the 8.10 client needs 4.35.1, while
           the Spring Boot BOM manages 4.34.2 and would win, because an imported BOM beats
           a transitive version. This entry stands BEFORE that import, so it is what every
           line gets, and it has to be at least the highest gencode version of the pinned
           clients. Raising it is safe, holding it back is not: the failure is an
           ExceptionInInitializerError on the first command that uses the protocol. -->
      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java</artifactId>
        <version>${protobuf.version}</version>
      </dependency>
      <dependency>
        <groupId>io.micrometer</groupId>
        <artifactId>micrometer-core</artifactId>
        <version>${micrometer.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${springboot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>${quarkus.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>spi-for-java</artifactId>
        <version>${spi-for-java.version}</version>
      </dependency>
      <dependency>
        <groupId>io.vanillabp.adapter</groupId>
        <artifactId>migration-adapter-spi</artifactId>
        <version>${adapter-platform.version}</version>
      </dependency>
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>vanillabp-spring-boot-integration</artifactId>
        <version>${adapter-platform.version}</version>
      </dependency>
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>vanillabp-quarkus-integration</artifactId>
        <version>${adapter-platform.version}</version>
      </dependency>
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>vanillabp-quarkus-integration-deployment</artifactId>
        <version>${adapter-platform.version}</version>
      </dependency>
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>test-utils</artifactId>
        <version>${adapter-platform.version}</version>
      </dependency>
      <dependency>
        <groupId>io.camunda</groupId>
        <artifactId>camunda-client-java</artifactId>
        <version>${camunda8.version}</version>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers</artifactId>
        <version>${testcontainers.version}</version>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-junit-jupiter</artifactId>
        <version>${testcontainers.version}</version>
      </dependency>
      <dependency>
        <groupId>org.projectlombok</groupId>
        <artifactId>lombok</artifactId>
        <version>${lombok.version}</version>
        <optional>true</optional>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.6</version>
          <configuration>
            <!-- '@{jacoco.agent}' is resolved lazily per module (late property binding),
                 forwarding coverage also into forked JVMs -->
            <argLine>@{jacoco.agent}</argLine>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>3.5.6</version>
          <configuration>
            <argLine>@{jacoco.agent}</argLine>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>integration-test</goal>
                <goal>verify</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.15.0</version>
          <configuration>
            <release>${version.java}</release>
            <annotationProcessorPaths>
              <path>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
              </path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- resolves '${revision}' in the POMs that get installed and deployed; without it
           a consumer would read a version they cannot resolve -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>1.8.0</version>
        <configuration>
          <updatePomFile>true</updatePomFile>
          <flattenMode>resolveCiFriendliesOnly</flattenMode>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <goals>
              <goal>flatten</goal>
            </goals>
            <phase>process-resources</phase>
          </execution>
          <execution>
            <id>flatten-clean</id>
            <goals>
              <goal>clean</goal>
            </goals>
            <phase>clean</phase>
          </execution>
        </executions>
      </plugin>
      <!-- The per-line delta: code which cannot compile against every supported client,
           or which uses something only a newer cluster has. Everything else stays
           shared, which is the whole point of building the lines from one source tree.
           The directories are usually absent, and that is the intended state. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>per-line-sources</id>
            <goals>
              <goal>add-source</goal>
            </goals>
            <phase>generate-sources</phase>
            <configuration>
              <sources>
                <source>src/main/java-line-${camunda8.line}</source>
              </sources>
            </configuration>
          </execution>
          <execution>
            <id>per-line-test-sources</id>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <phase>generate-test-sources</phase>
            <configuration>
              <sources>
                <source>src/test/java-line-${camunda8.line}</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <configuration>
          <propertyName>jacoco.agent</propertyName>
          <excludes>
            <exclude>**/it/**</exclude>
            <exclude>**/test/**</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <goals>
              <goal>report</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.10.0</version>
        <configuration>
          <pom>
            <includes>
              <include>**/pom.xml</include>
            </includes>
            <excludes>
              <exclude>**/target/**/</exclude>
              <exclude>**/node_modules/**/</exclude>
              <!-- the workflows carry comments, and the YAML formatter round-trips
                   through Jackson, which drops them -->
              <exclude>**/.github/**/</exclude>
            </excludes>
            <sortPom>
              <quiet>true</quiet>
            </sortPom>
          </pom>
          <markdown>
            <includes>
              <include>**/*.md</include>
            </includes>
            <excludes>
              <exclude>**/target/**/</exclude>
              <exclude>**/node_modules/**/</exclude>
              <!-- the workflows carry comments, and the YAML formatter round-trips
                   through Jackson, which drops them -->
              <exclude>**/.github/**/</exclude>
            </excludes>
            <flexmark/>
          </markdown>
          <yaml>
            <includes>
              <include>**/*.yaml</include>
            </includes>
            <excludes>
              <exclude>**/target/**/</exclude>
              <exclude>**/node_modules/**/</exclude>
              <!-- the workflows carry comments, and the YAML formatter round-trips
                   through Jackson, which drops them -->
              <exclude>**/.github/**/</exclude>
              <!--
                Workflow files are excluded on purpose, the same way the blueprints
                repository does it: the formatter drops comments, and it unquotes version
                numbers, which turns the release line '8.10' into 8.1 without a word.
              -->
              <exclude>.github/workflows/**</exclude>
            </excludes>
            <jackson>
              <yamlFeatures>
                <MINIMIZE_QUOTES>true</MINIMIZE_QUOTES>
                <WRITE_DOC_START_MARKER>false</WRITE_DOC_START_MARKER>
                <INDENT_ARRAYS_WITH_INDICATOR>true</INDENT_ARRAYS_WITH_INDICATOR>
              </yamlFeatures>
            </jackson>
          </yaml>
          <java>
            <!-- the per-line delta is code like any other, so the formatter sees it too -->
            <includes>
              <include>src/main/java/**/*.java</include>
              <include>src/test/java/**/*.java</include>
              <include>src/main/java-line-*/**/*.java</include>
              <include>src/test/java-line-*/**/*.java</include>
            </includes>
            <eclipse>
              <file>${maven.multiModuleProjectDirectory}/formatting_conventions.xml</file>
              <version>4.35</version>
            </eclipse>
            <removeUnusedImports/>
            <importOrder>
              <order>java,javax,org,com,at.phactum</order>
            </importOrder>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>process-sources</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- One profile per release line. It selects the client pin, and with it the cluster
         the integration tests run against, and it names the line for the runtime message
         and for the delta source directory. The properties above are the current GA line,
         so a build without any profile is that line: nothing to remember, and no
         'activeByDefault' which any other profile on the command line would switch off.
         Rotating the lines means editing these profiles, the pin properties, the Renovate
         boundary rule and the line table of the README. -->
    <profile>
      <!-- previous GA: bugfixes only, ends when the next minor goes GA -->
      <id>line-8.8</id>
      <properties>
        <camunda8.line>8.8</camunda8.line>
        <camunda8.version>${camunda8.version.line-8.8}</camunda8.version>
      </properties>
    </profile>
    <profile>
      <!-- current GA: everything lands here, and it is what a plain build produces -->
      <id>line-8.9</id>
      <properties>
        <camunda8.line>8.9</camunda8.line>
        <camunda8.version>${camunda8.version.line-8.9}</camunda8.version>
      </properties>
    </profile>
    <profile>
      <!-- preview: built against the alpha of the next minor and published as a
           pre-release, so a feature only the new cluster can do is deliverable before
           that cluster is GA -->
      <id>line-8.10</id>
      <properties>
        <camunda8.line>8.10</camunda8.line>
        <camunda8.version>${camunda8.version.line-8.10}</camunda8.version>
      </properties>
      <build>
        <pluginManagement>
          <plugins>
            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-failsafe-plugin</artifactId>
              <configuration>
                <!--
                  A user-task LISTENER job never reaches its worker on this line: the REST gateway
                  of camunda/camunda:8.10.0-alpha4 throws a NullPointerException while converting a
                  TASK_LISTENER job and drops the whole activate-jobs batch (camunda/camunda#58193,
                  open). Three tests then sit in their deadline and turn the line red as a whole,
                  which hides whatever else this line might break - and a matrix that is always red
                  stops being read. They are excluded here, by tag, so the rest of the line keeps
                  saying something. Remove this together with the tag once Camunda ships the fix.
                -->
                <excludedGroups>user-task-listener-jobs</excludedGroups>
              </configuration>
            </plugin>
            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-surefire-plugin</artifactId>
              <configuration>
                <!--
                  The same bug, in the suite which runs its end-to-end tests through surefire:
                  the Quarkus tests wait for a user task's CREATED notification which the broken
                  activate-jobs batch never delivers. Excluding the tag in failsafe alone left
                  this line red once it got as far as this module, which is the point where the
                  exclusion was supposed to start paying off.
                -->
                <excludedGroups>user-task-listener-jobs</excludedGroups>
              </configuration>
            </plugin>
          </plugins>
        </pluginManagement>
      </build>
    </profile>
  </profiles>
</project>
